<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java.zhou.Dao.LoginDao">
    <resultMap id="producaMeAuthUserResult" type="com.java.zhou.bo.ProduceAuthUserBo">
        <id property="userName" column="user_name"/>
        <result property="passWord" column="pass_word"/>
        <result property="auth" column="auth"/>
        <result property="date" column="date"/>
        <result property="recordStatus" column="record_status"/>
    </resultMap>
    <select id="findUser" resultType="com.java.zhou.bo.ProduceAuthUserBo">
        select user_name as userName
              ,pass_word as passWord
              ,auth
              ,date,
              record_status as recordStatus from produce_auth_user
        where record_status=0
        <if test="userName != null and userName !=''">
            and user_name=#{userName}
        </if>
    </select>
</mapper>