<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java.zhou.Dao.FindDao">
   <select id="find1" resultType="String">
       select name from a1;
   </select>
    <select id="find2" resultType="String">
       select name from a2;
   </select>
    <select id="find3" resultType="String">
       select a1.name from db.a1 a1 left join addr a2 on a1.id=a2.aid where a1.id=#{id};
   </select>
    <select id="find4" resultType="String">
       select name from a2 where id=#{id};
   </select>
    <insert id="insert1">
        insert into a1 values(#{id},#{name})
    </insert>
    <insert id="insert2">
        insert into a2 values(#{id},#{name})
    </insert>
</mapper>